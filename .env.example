APP_NAME=MarketEye
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production canonical host (Coolify should set this in live env):
# APP_URL=https://marketeye.ahzcode.sbs
APP_URL=https://your-domain.com

ADMIN_PANEL_URL="${APP_URL}/admin"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=market_eye
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (HTTP v1)
# Place service-account.json at storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=marketeye-f8498
FIREBASE_ANDROID_CHANNEL_ID=price-alerts
