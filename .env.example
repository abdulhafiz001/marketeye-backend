APP_NAME=MarketEye
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-domain.com

ADMIN_PANEL_URL=https://your-domain.com/admin

WORLDBANK_RTFP_NIGERIA_URL=https://microdata.worldbank.org/index.php/catalog/4503
WFP_NIGERIA_HDX_URL=https://data.humdata.org/dataset/wfp-food-prices-for-nigeria

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=market_eye
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
